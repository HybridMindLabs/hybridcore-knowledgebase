{
    "name": "hybridmindlabs/hybridcore-knowledgebase",
    "description": "Official Knowledgebase & Documentation extension for HybridCore — categorized guides, server tutorials, player report templates, live search, and feedback.",
    "type": "hybridcore-extension",
    "license": "proprietary",
    "homepage": "https://github.com/HybridMindLabs/hybridcore-knowledgebase",
    "authors": [
        {
            "name": "HybridMind Labs",
            "homepage": "https://github.com/HybridMindLabs"
        }
    ],
    "support": {
        "issues": "https://github.com/HybridMindLabs/hybridcore-knowledgebase/issues",
        "source": "https://github.com/HybridMindLabs/hybridcore-knowledgebase"
    },
    "keywords": [
        "hybridcore",
        "hybridcore-extension",
        "knowledgebase",
        "docs",
        "guides",
        "tutorials",
        "support"
    ],
    "require": {
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "Hybridcore\\Knowledgebase\\": "src/",
            "Hybridcore\\Knowledgebase\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "hybridcore": {
            "id": "hybridcore/knowledgebase"
        }
    }
}
